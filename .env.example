# Server-side only. Requires PostgreSQL with PostGIS and schema.sql applied.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/routes
# Desktop alternative: a generated read-only SQLite routing snapshot. When
# set, this takes precedence over DATABASE_URL. The desktop launcher sets it
# automatically; normal PostgreSQL development should leave it unset.
# BACKROADS_SQLITE_PATH=C:\path\to\backroads.sqlite3
# Optional comma-separated browser origins when frontend and API are hosted
# separately. Leave unset when FastAPI serves viewer.html from the same host.
ALLOWED_ORIGINS=https://backroad.example.com

# Optional self-hosted Valhalla service. When enabled, Backroads sends its
# scenic shaping points to Valhalla to produce legal driving geometry and
# turn-by-turn maneuvers. The original route remains available as a fallback.
# VALHALLA_URL=http://localhost:8002
# VALHALLA_ROUTE_VALIDATION=true
# VALHALLA_TIMEOUT_SECONDS=30

# Address search. The default is the public Nominatim service and is suitable
# only for modest, user-triggered beta use. Configure a hosted/self-hosted
# provider-compatible endpoint before scaling distribution.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=Backroads/1.0 (https://github.com/ixbh/Backroads)
# GEOCODER_TIMEOUT_SECONDS=10
